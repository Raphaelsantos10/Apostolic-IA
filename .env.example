# Variáveis públicas somente quando forem implementadas.
# Nunca colocar segredos neste arquivo.
NEXT_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_ENV=development

# Movimento enriquecido é opcional e nunca pode ignorar a preferência de
# redução de movimento do utilizador.
NEXT_PUBLIC_APOSTOLIC_ENHANCED_MOTION=false

# Prévia local das oito aulas em rascunho. Nunca habilitar em produção.
MODULE_01_REVIEW_MODE=disabled

# Origem canónica usada em redirecionamentos do servidor.
# Em produção deve ser HTTPS e não depender do cabeçalho Host.
APP_BASE_URL=http://localhost:3000

# Cobrança somente no servidor. Nunca usar prefixo NEXT_PUBLIC.
STRIPE_SECRET_KEY=<segredo-stripe>
STRIPE_WEBHOOK_SECRET=<segredo-webhook-stripe>
SUPABASE_SERVICE_ROLE_KEY=<service-role-somente-servidor>
OPENAI_API_KEY=<segredo-openai>
OPENAI_MODEL=gpt-5.6-sol

# Supabase público; preencher somente no ambiente local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<chave-publica-local>
