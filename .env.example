# Variáveis públicas somente quando forem implementadas.
# Nunca colocar segredos neste arquivo.
NEXT_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_ENV=development

# Cobrança somente no servidor. Nunca usar prefixo NEXT_PUBLIC.
STRIPE_SECRET_KEY=<segredo-stripe>
STRIPE_WEBHOOK_SECRET=<segredo-webhook-stripe>
SUPABASE_SERVICE_ROLE_KEY=<service-role-somente-servidor>

# Supabase público; preencher somente no ambiente local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<chave-publica-local>
