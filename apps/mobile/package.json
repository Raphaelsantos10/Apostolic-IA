{
  "name": "@apostolic-ia/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo start --android",
    "build": "expo export --platform web --output-dir web-build",
    "clean": "node -e \"require('fs').rmSync('web-build',{recursive:true,force:true})\"",
    "ios": "expo start --ios",
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web"
  },
  "dependencies": {
    "@apostolic-ia/design-tokens": "workspace:*",
    "@apostolic-ia/domain": "workspace:*",
    "@expo/metro-runtime": "57.0.15",
    "expo": "57.0.21",
    "expo-constants": "57.0.7",
    "expo-linking": "57.0.4",
    "expo-router": "57.0.8",
    "expo-status-bar": "57.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "5.9.1",
    "react-native-screens": "4.27.0",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.12.2"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "6.0.3"
  }
}
