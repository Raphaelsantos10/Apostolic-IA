{
  "name": "apostolic-ia",
  "version": "0.15.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22 <26"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @apostolic-ia/web dev",
    "dev:mobile": "pnpm --filter @apostolic-ia/mobile start",
    "typecheck": "turbo run typecheck",
    "validate": "pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "turbo": "2.10.7",
    "typescript": "6.0.3"
  }
}
